@page "/"

<PageTitle>Website Kiosk</PageTitle>

@if (IsRunning)
{
    <div class="slideshow-stage">
        <iframe id="website-kiosk-frame" class="slideshow-frame" title="Website Kiosk"></iframe>
        @if (DebugLoggingEnabled)
        {
            <div class="slideshow-debug-line">Debug: @DebugStatusText</div>
        }

        @if (IsScreenOff)
        {
            <div class="slideshow-screen-off" aria-hidden="true"></div>
        }

        @if (ShowArrowOverlayButtons)
        {
            <button type="button" class="slideshow-overlay-button left" aria-label="Previous URL" @onclick="GoPreviousAsync">
                <svg class="slideshow-arrow-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M14.5 5.5L8 12l6.5 6.5" />
                </svg>
            </button>
            <button type="button" class="slideshow-overlay-button right" aria-label="Next URL" @onclick="GoNextAsync">
                <svg class="slideshow-arrow-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9.5 5.5L16 12l-6.5 6.5" />
                </svg>
            </button>
        }

        @if (ShowPauseOverlayButton)
        {
            <button type="button" class="slideshow-overlay-button bottom-center @(IsPaused ? "paused" : string.Empty)" aria-label="@(IsPaused ? "Resume slideshow" : "Pause slideshow")" @onclick="TogglePause">
                @(IsPaused ? "▶" : "❚❚")
            </button>
        }

        @if (ShowSettingsOverlayButton)
        {
            <button type="button" class="slideshow-overlay-button bottom-left" aria-label="Open settings" @onclick="StopSlideshowAsync">⚙</button>
        }
        else
        {
            <button type="button"
                    class="slideshow-settings-hotspot"
                    aria-label="Hidden settings hotspot"
                    title="Double-tap here to open settings"
                    @ontouchend="OnSettingsHotspotTouchEnd"
                    @ondblclick="OnSettingsHotspotDoubleClick">
            </button>
        }
    </div>
}
else
{
    <section class="kiosk-panel card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                <div>
                    <h2 class="h4 mb-1">Settings</h2>
                    <p class="text-muted mb-0">Configure your Home Assistant connection for this kiosk.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(IsIntegrationSettingsInUse ? "text-bg-success" : "text-bg-secondary")">@(IsIntegrationSettingsInUse ? "Source: Home Assistant" : "Source: Local cache")</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshIntegrationSettingsAsync">Refresh</button>
                </div>
            </div>

            @if (Websites.Count > 0)
            {
                <details class="mb-3">
                    <summary class="fw-semibold">Rotation website URLs (@Websites.Count)</summary>
                    <ul class="list-group list-group-flush mt-2">
                        @foreach (var website in Websites.OrderBy(w => w.Order))
                        {
                            <li class="list-group-item px-0 py-2 text-break">
                                <small class="text-muted me-2">#@website.Order</small>@website.Url
                            </li>
                        }
                    </ul>
                </details>
            }

            @if (Websites.Count == 0)
            {
                <div class="alert alert-warning" role="alert">
                    No configured websites found. Configure rotation URLs in the Home Assistant integration settings.
                </div>
            }

            <div class="admin-settings">
                <div class="admin-setting-row">
                    <label for="integration-base-url" class="form-label mb-1">Home Assistant base URL</label>
                    <div class="admin-connect-row">
                        <input id="integration-base-url" class="admin-url form-control" value="@IntegrationBaseUrl" @oninput="OnIntegrationBaseUrlInput" />
                        <button type="button" class="@ConnectButtonCssClass" @onclick="ConnectToHomeAssistantAsync" disabled="@IsConnectionTestInProgress">@ConnectButtonText</button>
                    </div>
                    <small class="form-text text-muted">The root URL of your Home Assistant instance, for example: https://homeassistant.local:8123.</small>
                </div>
                <div class="admin-setting-row">
                    <label for="integration-device-id" class="form-label mb-1">Device identifier</label>
                    <input id="integration-device-id" class="admin-url form-control" value="@IntegrationDeviceId" @oninput="OnIntegrationDeviceIdInput" />
                    <small class="form-text text-muted">Must match the device identifier configured in the Website Kiosk integration.</small>
                </div>
                <div class="admin-setting-row">
                    <label for="integration-access-token" class="form-label mb-1">Access token (optional)</label>
                    <input id="integration-access-token" class="admin-url form-control" value="@IntegrationAccessToken" @oninput="OnIntegrationAccessTokenInput" />
                    <small class="form-text text-muted">Optional long-lived Home Assistant token. Leave blank if your endpoint works without it.</small>
                </div>
                <div class="admin-setting-row">
                    <label for="integration-poll-seconds" class="form-label mb-1">Poll frequency (secs)</label>
                    <InputNumber id="integration-poll-seconds" class="admin-order form-control poll-frequency-input" @bind-Value="IntegrationPollFrequencySeconds" min="1" />
                    <small class="form-text text-muted">How often this kiosk checks Home Assistant for commands.</small>
                </div>
                <div class="admin-setting-row">
                    <div class="form-check mt-1">
                        <InputCheckbox id="debug-logging-enabled" class="form-check-input" @bind-Value="DebugLoggingEnabled" />
                        <label for="debug-logging-enabled" class="form-check-label">Enable debug logging</label>
                    </div>
                    <small class="form-text text-muted">Shows live polling and command diagnostics while running the slideshow.</small>
                </div>
                <div class="admin-setting-row">
                    <div class="form-check mt-1">
                        <InputCheckbox id="show-arrow-overlay-buttons" class="form-check-input" @bind-Value="ShowArrowOverlayButtons" />
                        <label for="show-arrow-overlay-buttons" class="form-check-label">Show left/right overlay arrows</label>
                    </div>
                    <small class="form-text text-muted">Displays previous and next arrow controls on top of the slideshow.</small>
                </div>
                <div class="admin-setting-row">
                    <div class="form-check mt-1">
                        <InputCheckbox id="show-pause-overlay-button" class="form-check-input" @bind-Value="ShowPauseOverlayButton" />
                        <label for="show-pause-overlay-button" class="form-check-label">Show pause overlay button</label>
                    </div>
                    <small class="form-text text-muted">Displays the pause/resume button at the bottom-center of the slideshow.</small>
                </div>
                <div class="admin-setting-row">
                    <div class="form-check mt-1">
                        <InputCheckbox id="show-settings-overlay-button" class="form-check-input" @bind-Value="ShowSettingsOverlayButton" />
                        <label for="show-settings-overlay-button" class="form-check-label">Show settings overlay button</label>
                    </div>
                    <small class="form-text text-muted">Displays the settings button in the bottom-left. If disabled, double-tap the bottom-left corner to open settings.</small>
                </div>
            </div>

            @if (DebugLoggingEnabled && !string.IsNullOrWhiteSpace(ResolvedCommandUrlPreview))
            {
                <div class="admin-note mt-3">
                    Command endpoint preview: <code>@ResolvedCommandUrlPreview</code>
                    <a href="@ResolvedCommandUrlPreview" target="_blank" rel="noopener noreferrer" class="ms-2 text-decoration-none" aria-label="Open command endpoint preview in new tab" title="Open in new tab">🔗</a>
                </div>
            }

            <div class="admin-actions mt-3">
                <button type="button" class="btn btn-primary action-btn" @onclick="SaveIntegrationSettingsAsync">Save settings</button>
                <button type="button" class="btn btn-outline-primary action-btn" @onclick="StartSlideshowAsync" disabled="@IsRunning">Start slideshow</button>    
            </div>
        </div>
    </section>
}
